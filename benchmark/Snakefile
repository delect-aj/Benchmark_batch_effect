# Benchmark workflow: simulate / fetch data -> run every method -> score -> aggregate.
# Run on the compute node from benchmark/:  snakemake --cores 24 --keep-going
import os, re
import pandas as pd

configfile: "config/config.yaml"
R, PY, RDATA = (os.path.expanduser(config[k]) for k in ("rscript", "python", "rscript_data"))
SC = pd.read_csv(config["scenarios"], sep="\t").set_index("scenario")
SC = SC[SC.index.str.contains(config["only"])] if config["only"] else SC
SIMS = [f"sim/{s}/rep{r}" for s in SC.index for r in range(1, int(config["reps"]) + 1)]
REAL = [f"real/{d}" for d in config["real"]]
METHODS, SENS = config["methods"], config.get("sensitivity_methods", [])
SCRIPT = {m: next(f"methods/{m}{e}" for e in (".R", ".py") if os.path.exists(f"methods/{m}{e}")) for m in METHODS + SENS}

def methods_for(ds):
    if not ds.startswith("sim/"):
        return [m for m in METHODS if m != "oracle"]
    return METHODS + (SENS if re.search(config["sensitivity_only"], ds.split("/")[1]) else [])

wildcard_constraints:
    ds = r"(sim/[^/]+/rep\d+|real/[^/]+)", m = r"[^/]+", scen = r"[^/]+", rep = r"\d+"

rule all:
    input: "results/scores.tsv"

rule fit_template:
    input: "{t}.tsv"
    output: "{t}.tsv.midasim.rds"
    shell: "{R} simulate/sim.R {input} --fit"

rule sim:
    input: lambda w: config["templates"][SC.loc[w.scen, "template"]] + ".midasim.rds"
    output: multiext("results/data/sim/{scen}/rep{rep}/", "counts.tsv", "meta.tsv", "oracle.tsv", "truth_da.txt", "truth_fc.tsv", "params.json")
    params:
        template = lambda w: config["templates"][SC.loc[w.scen, "template"]],
        kv = lambda w: " ".join(f"{k}={v}" for k, v in SC.loc[w.scen].items() if k != "template"),
        seed = lambda w: 1000 * list(SC.index).index(w.scen) + int(w.rep)
    shell: "{R} simulate/sim.R {params.template} results/data/sim/{wildcards.scen}/rep{wildcards.rep} {params.kv} seed={params.seed}"

rule template_16s:
    output: "data/templates/16s.tsv"
    shell: "{R} simulate/make_templates.R 16s {output}"

rule template_mgx:
    input: "results/data/real/crc_mgx/counts.tsv"
    output: "data/templates/mgx.tsv"
    shell: "{R} simulate/make_templates.R mgx {output} results/data/real/crc_mgx"

rule cmd:  # curatedMetagenomicData cohorts (bench-data env)
    output: multiext("results/data/real/{name}/", "counts.tsv", "meta.tsv", "taxonomy.tsv")
    wildcard_constraints: name = "crc_mgx|ibd_mgx|ici_mgx"
    shell: "{RDATA} data/cmd.R {wildcards.name} results/data/real/{wildcards.name}"

rule microbiomehd:  # 16S case-control studies from MicrobiomeHD (Zenodo 569601), genus level
    output: multiext("results/data/real/{name}/", "counts.tsv", "meta.tsv", "taxonomy.tsv")
    wildcard_constraints: name = "crc_16s|ibd_16s|hiv_16s"
    params: repo = os.path.expanduser(config["microbiomehd_repo"])
    shell: "{R} data/microbiomehd.R {wildcards.name} results/data/real/{wildcards.name} results/raw/microbiomehd {params.repo}"

rule seed_16s:  # seed microbiome (Foxx & Rivers 2025, Mendeley Data)
    output: multiext("results/data/real/seed_16s/", "counts.tsv", "meta.tsv")
    shell: "{R} data/seed_16s.R results/data/real/seed_16s results/raw/seed"

rule brooks_mock:  # mock communities for calibration (metacal); not in the method run list
    output: multiext("results/data/mock/brooks/", "counts.tsv", "truth.tsv", "meta.tsv")
    shell: "{R} data/brooks_mock.R results/data/mock/brooks"

rule data:  # every dataset, without running methods
    input: [f"results/data/{ds}/counts.tsv" for ds in REAL] + ["results/data/mock/brooks/counts.tsv"]

rule run:
    input: "results/data/{ds}/counts.tsv", "results/data/{ds}/meta.tsv"
    output: "results/out/{ds}/{m}.status"
    benchmark: "results/bench/{ds}/{m}.txt"
    log: "results/logs/{ds}/{m}.log"
    threads: lambda w: config["threads"].get(w.m, 1)
    params:
        exe = lambda w: R if SCRIPT[w.m].endswith(".R") else PY,
        script = lambda w: SCRIPT[w.m], out = "results/out/{ds}/{m}.tsv", t = config["timeout"]
    shell:
        """
        export OMP_NUM_THREADS={threads} MKL_NUM_THREADS={threads}
        if timeout {params.t} {params.exe} {params.script} {input} {params.out} > {log} 2>&1; then echo ok > {output}
        else echo "fail $?" > {output}; rm -f {params.out} {params.out}.json; fi
        """

rule score:
    input: "results/out/{ds}/{m}.status"
    output: "results/out/{ds}/{m}.score"
    log: "results/logs/{ds}/{m}.score.log"
    shell:
        """
        if grep -q '^ok' {input} && {R} metrics/compute.R results/data/{wildcards.ds} results/out/{wildcards.ds}/{wildcards.m}.tsv {output} 2> {log}; then :
        else printf 'method\\n{wildcards.m}\\n' > {output}; fi
        """

rule aggregate:
    input: [f"results/out/{ds}/{m}.score" for ds in SIMS + REAL for m in methods_for(ds)]
    output: "results/scores.tsv"
    run:
        # Pass exactly the workflow's inputs (a file list: ~68k paths exceed the shell's argument limit),
        # so stray score files from manual runs never leak into results
        with open(output[0] + ".inputs", "w") as f:
            f.write("\n".join(input) + "\n")
        shell("{R} report/aggregate.R results {output}.inputs {output}")
