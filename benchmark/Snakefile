# Benchmark workflow: simulate / fetch data -> run every method -> score -> aggregate.
# Run on the compute node from benchmark/:  snakemake --cores 24 --keep-going
import os, re
import pandas as pd

configfile: "config/config.yaml"
R, PY, RDATA = (os.path.expanduser(config[k]) for k in ("rscript", "python", "rscript_data"))
RDADA, SILVA = os.path.expanduser(config["rscript_dada2"]), config["silva"]
SC = pd.read_csv(config["scenarios"], sep="\t").set_index("scenario")
SC = SC[SC.index.str.contains(config["only"])] if config["only"] else SC
SIMS = [f"sim/{s}/rep{r}" for s in SC.index for r in range(1, int(config["reps"]) + 1)]
REAL = [f"real/{d}" for d in config["real"]]
MOCK = [f"mock/{d}" for d in config["mock"]]
LOSO, TRUTH = config["loso"], config["truth"]
# Method inventory: output kind, requirements, display label. Also what the figures label axes with.
MI = pd.read_csv("config/methods.tsv", sep="\t").set_index("method")
keep = lambda names: [m for m in names if re.search(config["methods_only"], m)]
METHODS, SENS = keep(config["methods"]), keep(config.get("sensitivity_methods", []))
SCRIPT = {m: next(f"methods/{m}{e}" for e in (".R", ".py") if os.path.exists(f"methods/{m}{e}")) for m in METHODS + SENS}

def methods_for(ds):
    if not ds.startswith("sim/"):
        return [m for m in METHODS if m != "oracle"]
    return METHODS + (SENS if re.search(config["sensitivity_only"], ds.split("/")[1]) else [])

wildcard_constraints:
    ds = r"(sim/[^/]+/rep\d+|real/[^/]+|mock/[^/]+)", m = r"[^/]+", scen = r"[^/]+", rep = r"\d+"

rule all:
    input: [f"results/figures/fig{i}.pdf" for i in range(1, 6)]

rule fit_template:
    input: "{t}.tsv"
    output: "{t}.tsv.midasim.rds"
    shell: "{R} simulate/sim.R {input} --fit"

rule sim:
    input: lambda w: config["templates"][SC.loc[w.scen, "template"]] + ".midasim.rds"
    output: multiext("results/data/sim/{scen}/rep{rep}/", "counts.tsv", "meta.tsv", "oracle.tsv", "truth_da.txt", "truth_fc.tsv", "params.json")
    params:
        template = lambda w: config["templates"][SC.loc[w.scen, "template"]],
        kv = lambda w: " ".join(f"{k}={v}" for k, v in SC.loc[w.scen].items() if k != "template"),
        seed = lambda w: 1000 * list(SC.index).index(w.scen) + int(w.rep)
    shell: "{R} simulate/sim.R {params.template} results/data/sim/{wildcards.scen}/rep{wildcards.rep} {params.kv} seed={params.seed}"

rule template_16s:
    output: "data/templates/16s.tsv"
    shell: "{R} simulate/make_templates.R 16s {output}"

rule template_mgx:
    input: "results/data/real/crc_mgx/counts.tsv"
    output: "data/templates/mgx.tsv"
    shell: "{R} simulate/make_templates.R mgx {output} results/data/real/crc_mgx"

rule cmd:  # curatedMetagenomicData cohorts (bench-data env)
    output: multiext("results/data/real/{name}/", "counts.tsv", "meta.tsv", "taxonomy.tsv")
    wildcard_constraints: name = "crc_mgx|ibd_mgx|ici_mgx"
    shell: "{RDATA} data/cmd.R {wildcards.name} results/data/real/{wildcards.name}"

rule microbiomehd:  # 16S case-control studies from MicrobiomeHD (Zenodo 569601), genus level
    output: multiext("results/data/real/{name}/", "counts.tsv", "meta.tsv", "taxonomy.tsv")
    wildcard_constraints: name = "crc_16s|ibd_16s|hiv_16s"
    shell: "{R} data/microbiomehd.R {wildcards.name} results/data/real/{wildcards.name} results/raw/microbiomehd"

rule hivrc_16s:  # HIVRC 17 HIV studies; source files come from Synapse by hand (data/README.md)
    input: multiext("results/raw/hivrc/", "insight.merged_genus.txt", "SupplementaryMaterial.xlsx")
    output: multiext("results/data/real/hivrc_16s/", "counts.tsv", "meta.tsv", "taxonomy.tsv")
    shell: "{R} data/hivrc_16s.R results/data/real/hivrc_16s results/raw/hivrc"

rule seed_16s:  # seed microbiome (Foxx & Rivers 2025, Mendeley Data)
    output: multiext("results/data/real/seed_16s/", "counts.tsv", "meta.tsv")
    shell: "{R} data/seed_16s.R results/data/real/seed_16s results/raw/seed"

rule brooks_mock:  # mock communities for calibration (metacal); not in the method run list
    output: multiext("results/data/mock/brooks/", "counts.tsv", "truth.tsv", "meta.tsv")
    shell: "{R} data/brooks_mock.R results/data/mock/brooks"

rule mbqc:  # 13 handling labs x 22 specimens, 16S V4; needs the reads fetched first (data/mbqc_download.sh)
    input: multiext("results/raw/mbqc/", "mbqc_manifest.tsv", "mbqc_samples.tsv"), "results/raw/mbqc/fastq/.complete"
    output: multiext("results/data/real/mbqc/", "counts.tsv", "meta.tsv", "taxonomy.tsv")
    shell: "{RDADA} -f data/mbqc.R --args results/data/real/mbqc results/raw/mbqc {SILVA}"

rule jmbc_extraction:  # 9 DNA extraction protocols on a 20-strain mock and on feces -- the only dataset here
    input: "results/raw/jmbc/counts_long.tsv"   # whose batch variable is the extraction method itself
    output: multiext("results/data/real/jmbc_extraction/", "counts.tsv", "meta.tsv", "taxonomy.tsv", "truth.tsv")
    shell: "{R} data/jmbc.R extraction results/data/real/jmbc_extraction results/raw/jmbc"

rule jmbc_library:  # 28 library preparations of one DNA mock: nothing biological varies, so it is a null set
    input: "results/raw/jmbc/counts_long.tsv"
    output: multiext("results/data/mock/jmbc_library/", "counts.tsv", "meta.tsv", "taxonomy.tsv", "truth.tsv")
    shell: "{R} data/jmbc.R library results/data/mock/jmbc_library results/raw/jmbc"

rule salim_pig:  # storage/handling experiment (PRJEB31650): published count tables, calibration only
    output: multiext("results/data/mock/salim_pig/", "counts.tsv", "meta.tsv", "truth.tsv", "taxonomy.tsv")
    shell: "{R} data/salim_pig.R results/data/mock/salim_pig results/raw/salim"

rule data:  # every dataset, without running methods
    input: [f"results/data/{ds}/counts.tsv" for ds in REAL + MOCK]

rule run:
    input: "results/data/{ds}/counts.tsv", "results/data/{ds}/meta.tsv"
    output: "results/out/{ds}/{m}.status"
    benchmark: "results/bench/{ds}/{m}.txt"
    log: "results/logs/{ds}/{m}.log"
    threads: lambda w: config["threads"].get(w.m, 1)
    params:
        exe = lambda w: R if SCRIPT[w.m].endswith(".R") else PY,
        script = lambda w: SCRIPT[w.m], out = "results/out/{ds}/{m}.tsv", t = config["timeout"]
    shell:
        """
        export OMP_NUM_THREADS={threads} MKL_NUM_THREADS={threads}
        if timeout {params.t} {params.exe} {params.script} {input} {params.out} > {log} 2>&1; then echo ok > {output}
        else echo "fail $?" > {output}; rm -f {params.out} {params.out}.json; fi
        """

rule score:
    input: "results/out/{ds}/{m}.status"
    output: "results/out/{ds}/{m}.score"
    log: "results/logs/{ds}/{m}.score.log"
    shell:
        """
        if grep -q '^ok' {input} && {R} metrics/compute.R results/data/{wildcards.ds} results/out/{wildcards.ds}/{wildcards.m}.tsv {output} 2> {log}; then :
        else printf 'method\\n{wildcards.m}\\n' > {output}; fi
        """

rule loso:  # cross-study prediction, re-split from the table the method already produced (upper bound)
    input: "results/out/real/{ds}/{m}.status", "results/data/real/{ds}/meta.tsv"
    output: "results/loso/{ds}/{m}.tsv"
    log: "results/logs/loso/{ds}/{m}.log"
    shell:
        """
        if grep -q '^ok' {input[0]} && {R} metrics/loso.R results/data/real/{wildcards.ds} \
             results/out/real/{wildcards.ds}/{wildcards.m}.tsv {output} > {log} 2>&1; then :
        else printf 'dataset\tmethod\theld_out\tclassifier\tauroc\tn_train\tn_test\tn_pos_test\tstatus\n{wildcards.ds}\t{wildcards.m}\tNA\tNA\tNA\tNA\tNA\tNA\tcorrection unavailable\n' > {output}; fi
        """

rule loso_all:
    input: [f"results/loso/{d}/{m}.tsv" for d in LOSO for m in METHODS if m != "oracle"]

rule truth:  # distance to the composition that was actually pipetted, for the designed mock datasets
    input: "results/out/{ds}/{m}.status", "results/data/{ds}/truth.tsv"
    output: summary = "results/truth/{ds}/{m}.summary.tsv", taxon = "results/truth/{ds}/{m}.taxon.tsv"
    log: "results/logs/truth/{ds}/{m}.log"
    shell:   # a method that could not run on this dataset is recorded, like elsewhere, as a result
        """
        if grep -q '^ok' {input[0]} && {R} metrics/truth.R results/data/{wildcards.ds} \
             results/out/{wildcards.ds}/{wildcards.m}.tsv {output.summary} {output.taxon} > {log} 2>&1; then :
        else printf 'dataset\tmethod\tstatus\n{wildcards.ds}\t{wildcards.m}\tcorrection unavailable\n' > {output.summary}
             printf 'dataset\tmethod\ttaxon\tn_samples\tlog2_ratio\tbatch_sd\n' > {output.taxon}
        fi
        """

# Embeddings have no taxon axis, so they are not scored against a known composition.
TABLE_METHODS = [m for m in METHODS if MI.loc[m, "output"] != "embedding" and m != "oracle"]

rule collect:  # the three tidy tables the figures read
    input:
        scores = "results/scores.tsv",
        truth = [f"results/truth/{d}/{m}.{k}.tsv" for d in TRUTH for m in TABLE_METHODS
                 for k in ("summary", "taxon")],
        loso = [f"results/loso/{d}/{m}.tsv" for d in LOSO for m in METHODS if m != "oracle"]
    output: "results/truth_summary.tsv", "results/truth_taxon.tsv", "results/loso.tsv"
    run:
        for out, paths in zip(output, [[p for p in input.truth if p.endswith("summary.tsv")],
                                       [p for p in input.truth if p.endswith("taxon.tsv")],
                                       list(input.loso)]):
            pd.concat([pd.read_csv(p, sep="\t") for p in paths]).to_csv(out, sep="\t", index=False)

rule figures:
    input: "results/scores.tsv", "results/truth_summary.tsv", "results/truth_taxon.tsv", "results/loso.tsv"
    output: [f"results/figures/fig{i}.pdf" for i in range(1, 6)]
    log: "results/logs/figures.log"
    shell: "for i in 1 2 3 4 5; do {R} figures/fig$i.R results results/figures/fig$i.pdf; done > {log} 2>&1"

rule aggregate:
    input: [f"results/out/{ds}/{m}.score" for ds in SIMS + REAL for m in methods_for(ds)]
    output: "results/scores.tsv"
    run:
        # Pass exactly the workflow's inputs (a file list: ~68k paths exceed the shell's argument limit),
        # so stray score files from manual runs never leak into results
        with open(output[0] + ".inputs", "w") as f:
            f.write("\n".join(input) + "\n")
        shell("{R} report/aggregate.R results {output}.inputs {output}")
